{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-forge.local/schemas/external-runtime-request.schema.json",
  "title": "Forge External Runtime Request",
  "type": "object",
  "required": [
    "request_id",
    "runtime",
    "project_id",
    "task_id",
    "capsule_id",
    "capsule_revision",
    "objective",
    "acceptance",
    "workspace_path",
    "result_schema"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "runtime": {"enum": ["codex", "claude_code", "opencode", "gemini_cli"]},
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "capsule_id": {"type": "string", "minLength": 1},
    "capsule_revision": {"type": "integer", "minimum": 1},
    "objective": {"type": "string", "minLength": 1},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "constraints": {"type": "object"},
    "workspace_path": {"type": "string", "minLength": 1},
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "capability_grant_refs": {"type": "array", "items": {"type": "string"}},
    "verification_requirements": {"type": "array", "items": {"type": "string"}},
    "result_schema": {"type": "string", "const": "schemas/worker-result.schema.json"},
    "timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 14400}
  },
  "additionalProperties": false
}
