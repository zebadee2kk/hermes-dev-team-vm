{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-forge.local/schemas/knowledge-page.schema.json",
  "title": "Forge Compiled Knowledge Page",
  "type": "object",
  "required": ["slug", "title", "summary", "about", "status", "claims"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "about": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["draft", "active", "review_due", "superseded"]},
    "review_after": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "links": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "text", "origin", "source_refs"],
        "properties": {
          "claim_id": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "origin": {"enum": ["asserted", "inferred"]},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^raw:[A-Za-z0-9._:-]+$"}
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "fact_key": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:/-]+$"},
          "contradicts": {
            "type": "array",
            "items": {"type": "string", "pattern": "^wiki:[a-z0-9][a-z0-9/_-]*#[A-Za-z0-9._:-]+$"}
          },
          "supersedes": {
            "type": "array",
            "items": {"type": "string", "pattern": "^wiki:[a-z0-9][a-z0-9/_-]*#[A-Za-z0-9._:-]+$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
