{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/decision.schema.json",
  "title": "Forge Human Decision",
  "type": "object",
  "required": ["id", "question", "recommendation", "authority", "status"],
  "properties": {
    "id": {"type": "string"},
    "question": {"type": "string"},
    "recommendation": {"type": "string"},
    "authority": {"enum": ["L0", "L1", "L2", "L3"]},
    "status": {"enum": ["OPEN", "ACCEPTED", "REJECTED", "DEFERRED", "MORE_INFO"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "blocking_nodes": {"type": "array", "items": {"type": "string"}}
  }
}
