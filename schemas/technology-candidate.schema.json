{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-forge.local/schemas/technology-candidate.schema.json",
  "title": "Forge Technology Candidate",
  "type": "object",
  "required": ["candidate_id", "name", "kind", "status", "problem", "proposed_value", "evidence_refs", "integration_seam", "test_plan", "acceptance"],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "kind": {"enum": ["primitive", "protocol", "pattern", "framework", "wrapper", "security_signal"]},
    "status": {"enum": ["observed", "triaged", "sandbox_tested", "probation", "promoted", "rejected"]},
    "problem": {"type": "string", "minLength": 1},
    "proposed_value": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "replacement_scope": {"type": "array", "items": {"type": "string"}},
    "integration_seam": {"type": "string", "minLength": 1},
    "test_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "probation_started_at": {"type": ["string", "null"], "format": "date-time"},
    "promoted_at": {"type": ["string", "null"], "format": "date-time"},
    "rollback": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
