{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-forge.local/schemas/knowledge-acquisition.schema.json",
  "title": "Forge Trusted Knowledge Acquisition Request",
  "type": "object",
  "required": ["project_id", "source_id", "approval_ref", "proposal"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": ["string", "null"]},
    "source_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "approval_ref": {"type": "string", "minLength": 1},
    "source_url": {"type": ["string", "null"]},
    "media_type": {"type": "string", "minLength": 1},
    "suffix": {"type": "string"},
    "shared_global_knowledge": {"type": "boolean"},
    "proposal": {
      "type": "object",
      "required": ["suggested_slug", "title", "about", "rationale"],
      "properties": {
        "suggested_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "about": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
