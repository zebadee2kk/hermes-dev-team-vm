# Install as /etc/hermes-forge/sandbox-broker.env with root ownership and mode 0640 or stricter.
# Generate a long random value; do not reuse FORGE_GATEWAY_KEY.
FORGE_SANDBOX_BROKER_KEY=change-me-long-random-value
FORGE_SANDBOX_WORKSPACE_ROOT=/var/lib/forge/workspaces

# Keep false until the host preflight proves Docker's runsc runtime and negative isolation tests pass.
FORGE_SANDBOX_EXECUTION_ENABLED=false
