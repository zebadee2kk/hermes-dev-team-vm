[Unit]
Description=Hermes Forge trusted Sandbox Broker
Documentation=https://github.com/zebadee2kk/hermes-dev-team-vm/blob/main/docs/sandbox-broker.md
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=forge-sandbox
Group=forge-control
# WARNING: membership of the Docker group is effectively host-runtime control.
# Only this trusted broker identity should receive it; never Hermes/Forge workers.
SupplementaryGroups=docker
WorkingDirectory=/opt/hermes-forge
EnvironmentFile=/etc/hermes-forge/sandbox-broker.env
RuntimeDirectory=forge-sandbox
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/opt/hermes-forge/.venv/bin/uvicorn forge_controller.sandbox_broker:app --uds /run/forge-sandbox/broker.sock --workers 1
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/forge/workspaces /run/forge-sandbox

[Install]
WantedBy=multi-user.target
