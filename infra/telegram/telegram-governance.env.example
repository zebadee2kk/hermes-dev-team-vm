# Non-secret Telegram governance settings.
# Bot token, Forge control key and HMAC/notification keys use systemd LoadCredential=.
FORGE_TELEGRAM_OWNER_CHAT_ID=123456789
FORGE_TELEGRAM_OWNER_USER_ID=123456789
FORGE_TELEGRAM_GOVERNANCE_URL=http://127.0.0.1:8080
FORGE_TELEGRAM_STATE_FILE=/var/lib/forge-telegram/state.json
FORGE_TELEGRAM_NOTIFY_SOCKET=/run/forge-telegram/notify.sock
FORGE_TELEGRAM_TIMEZONE=Europe/London
FORGE_TELEGRAM_DIGEST_HOUR=19
