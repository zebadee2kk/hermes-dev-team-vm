# Install as /etc/forge/codex-runtime.env, owned by root:root and mode 0600.
# No secret belongs in this file.
FORGE_CODEX_WORKSPACE=/var/lib/forge/workspaces/forge/probation-001
FORGE_CODEX_IMAGE=sha256:replace-with-built-codex-hand-image-id
FORGE_CODEX_NETWORK=forge-codex-internal
FORGE_CODEX_AUTH_VOLUME=forge-codex-probation-auth
FORGE_CODEX_PROXY_URL=http://forge-codex-egress:3128
