# Non-secret settings for forge-github-broker.service.
# Secrets are supplied only through systemd LoadCredential=.
FORGE_GITHUB_APP_ID=replace-with-app-id
FORGE_GITHUB_INSTALLATION_ID=12345678
FORGE_GITHUB_INSTALLATION_OWNER=zebadee2kk
FORGE_CAPABILITY_KEY_ID=forge-capability-v1
FORGE_GITHUB_CAPABILITY_POLICY=/etc/forge/capability-policy.yaml
FORGE_GITHUB_WORKSPACE_REGISTRY=/etc/forge/github-workspaces.json
FORGE_GITHUB_WORKSPACE_ROOT=/var/lib/forge/workspaces
FORGE_GITHUB_BROKER_SOCKET=/run/forge-github/broker.sock
