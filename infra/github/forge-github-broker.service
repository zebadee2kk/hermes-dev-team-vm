[Unit]
Description=Hermes Forge trusted GitHub capability broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forge-github
Group=forge-github
RuntimeDirectory=forge-github
RuntimeDirectoryMode=0770
UMask=0007
EnvironmentFile=/etc/forge/github-broker.env
LoadCredential=github-app-private-key:/etc/forge/secrets/github-app-private-key.pem
LoadCredential=capability-hmac-key:/etc/forge/secrets/capability-hmac-key.hex
LoadCredential=broker-api-key:/etc/forge/secrets/github-broker-api-key
ExecStart=/opt/forge/venv/bin/forge-github-broker
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/lib/forge/workspaces
ReadOnlyPaths=/etc/forge/capability-policy.yaml
ReadOnlyPaths=/etc/forge/github-workspaces.json

[Install]
WantedBy=multi-user.target
