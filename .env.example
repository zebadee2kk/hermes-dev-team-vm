# Control plane
FORGE_ENV=development
FORGE_LOG_LEVEL=INFO
FORGE_PAID_EMERGENCY_BUDGET_GBP=0

# PostgreSQL / Redis
POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://forge:change-me@localhost:5432/forge
REDIS_URL=redis://localhost:6379/0

# LiteLLM
LITELLM_MASTER_KEY=change-me-long-random-value
LITELLM_SALT_KEY=change-me-long-random-value
LITELLM_DATABASE_URL=postgresql://forge:change-me@postgres:5432/forge
LITELLM_BASE_URL=http://localhost:4000
LITELLM_RUNTIME_CONFIG_PATH=/runtime/litellm/config.yaml
# Binding -> ENVIRONMENT VARIABLE NAME only. Do not put secret values in this JSON.
FORGE_CREDENTIAL_ENV_JSON={"provider:groq:free":"GROQ_API_KEY","provider:openrouter:free":"OPENROUTER_API_KEY","provider:gemini:free":"GEMINI_API_KEY","provider:sambanova:free":"SAMBANOVA_API_KEY"}

# Free API providers — configure only accounts you own; never commit values.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
NVIDIA_NIM_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
HF_TOKEN=

# Optional local model endpoint
OLLAMA_BASE_URL=http://host.docker.internal:11434
